{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true,
    "strictFunctionTypes": false,
    "noImplicitAny": false,
    "allowJs": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "types/**/*.d.ts",
    "vite.config.ts",
    "node_modules/yuheng-ui/compat/types/**/*.d.ts"
  ]
}
